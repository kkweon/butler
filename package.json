{
  "name": "butler",
  "version": "0.0.0-development",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "clean": "rm -rf dist",
    "build": "ng build butler",
    "build:prod": "ng build butler --configuration production",
    "build:work": "RUN_UPDATE_MANIFEST=true yarn build",
    "build:work:prod": "RUN_UPDATE_MANIFEST=true yarn build:prod",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts, html, js, json, yaml, scss}\" \"*.{json,yaml,yml,js,ts}\"",
    "zip": "rm -rf dist && yarn build:prod && cd dist/butler && zip -r -9 butler.zip .",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "fuse.js": "^7.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^22.0.1",
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^2",
    "@semantic-release/exec": "^7.1.0",
    "@types/chrome": "^0.2.5",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/types": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "angular-eslint": "^22.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "puppeteer": "^25.6.0",
    "semantic-release": "^24.2.5",
    "ts-node": "~10.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "webpack-shell-plugin-next": "^2.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kkweon/butler.git"
  }
}
